{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "runtime": "python3.12",
      "excludeFiles": "{generated/**,.github/**,tests/**,__tests__/**,**/*.test.py,**/test_*.py,fixtures/**,__fixtures__/**,testdata/**,sample-data/**,static/**,assets/**,*.mp4,*.mov,*.wav,*.mp3,*.png,*.jpg,*.jpeg,*.webp,*.gif,**/__pycache__/**,**/.pytest_cache/**,docs/**}"
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.py" }
  ]
}
