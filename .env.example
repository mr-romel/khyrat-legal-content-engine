# Local development environment template.
# Never put real credentials in this file or commit a populated .env.
# Configure production values as GitHub Actions repository/environment secrets.

# Google Sheets / service account
GOOGLE_SERVICE_ACCOUNT_JSON=
# Compatibility alias; use only if existing deployment still depends on it.
GOOGLE_CREDENTIALS=
GOOGLE_SHEET_ID=
# Alternatively provide GOOGLE_SHEET_URL instead of GOOGLE_SHEET_ID.
GOOGLE_SHEET_URL=
GOOGLE_SHEET_RANGE=Content!A:BC
REEL_GOOGLE_SHEET_RANGE=Content!A:BZ
BLOGGER_GOOGLE_SHEET_RANGE=Content!A:BC

# AI text and image providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=
POLLINATIONS_API_KEY=
PIXABAY_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Approved neural narration providers only
GOOGLE_TTS_LANGUAGE=ar-XA
GOOGLE_TTS_VOICE=ar-XA-Wavenet-D
GOOGLE_TTS_SPEAKING_RATE=0.96
GOOGLE_TTS_PITCH=0.0
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=

# Telegram review and delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_USER_ID=
TELEGRAM_WEBHOOK_SECRET=

# Facebook publishing / engagement
FACEBOOK_PAGE_ID=464216073916915
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_USER_ACCESS_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=26.0

# LinkedIn publishing / engagement
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_AUTHOR_URN=
LINKEDIN_VERSION=

# Blogger
BLOGGER_ENABLED=true
BLOGGER_OAUTH_JSON=
BLOGGER_BLOG_ID=
BLOGGER_URL=https://askmahmoudkhyrat.blogspot.com/
BLOGGER_UI_STORAGE_STATE_B64=

# Reel / runtime controls
KHYRAT_DRY_RUN=false
REEL_FORCE_REGENERATE=false
REEL_FORCE_TELEGRAM_REVIEW=false
REEL_IMAGE_PROVIDER_TIMEOUT_SECONDS=120
REEL_IMAGE_CACHE_DIR=generated/reel_image_cache

# Marketplace remote dashboard (optional)
MARKETPLACE_CLOUDFLARE_TUNNEL_TOKEN=
MARKETPLACE_REMOTE_URL=
